{
  "workflow_schema_version": "1.0",
  "status": "succeeded",
  "workflow": {
    "schema_version": "1.0",
    "task_summary": "Normalize headerless CSV to label/sequence columns, validate peptides, compute statistics, deduplicate, then export cleaned CSV and generate basic length/label charts.",
    "steps": [
      {
        "id": "step_01",
        "skill": "peptide_csv_normalize",
        "inputs": [
          {
            "source": "uploaded",
            "ref": "Validation"
          }
        ],
        "parameters": {
          "delimiter": "auto",
          "label_column": "0",
          "sequence_column": "1",
          "drop_empty_rows": true
        },
        "outputs": [
          {
            "name": "normalized_csv",
            "format": "csv"
          }
        ],
        "reason": "The uploaded CSV appears to have no header; normalize to canonical 'label' and 'sequence' columns using column indices 0 and 1."
      },
      {
        "id": "step_02",
        "skill": "peptide_validate",
        "inputs": [
          {
            "source": "step",
            "ref": "normalized_csv"
          }
        ],
        "parameters": {
          "invalid_row_policy": "reject"
        },
        "outputs": [
          {
            "name": "validated_csv",
            "format": "csv"
          }
        ],
        "reason": "Validate peptide sequences and binary labels after normalization, rejecting invalid rows."
      },
      {
        "id": "step_03",
        "skill": "peptide_statistics",
        "inputs": [
          {
            "source": "step",
            "ref": "validated_csv"
          }
        ],
        "parameters": {
          "group_by_label": true,
          "include_amino_acid_composition": true
        },
        "outputs": [
          {
            "name": "statistics_json",
            "format": "json"
          }
        ],
        "reason": "Calculate label counts and peptide length distribution before deduplication, as requested."
      },
      {
        "id": "step_04",
        "skill": "peptide_deduplicate",
        "inputs": [
          {
            "source": "step",
            "ref": "validated_csv"
          }
        ],
        "parameters": {
          "conflict_policy": "prefer_positive",
          "keep": "first"
        },
        "outputs": [
          {
            "name": "deduplicated_csv",
            "format": "csv"
          }
        ],
        "reason": "Remove duplicate peptide sequences to obtain a clean non-redundant set."
      },
      {
        "id": "step_05",
        "skill": "peptide_csv_export",
        "inputs": [
          {
            "source": "step",
            "ref": "deduplicated_csv"
          }
        ],
        "parameters": {
          "columns": [
            "label",
            "sequence"
          ],
          "filename": "cleaned_Validation.csv"
        },
        "outputs": [
          {
            "name": "exported_csv",
            "format": "csv"
          }
        ],
        "reason": "Export the cleaned, deduplicated CSV for downstream use."
      },
      {
        "id": "step_06",
        "skill": "peptide_chart",
        "inputs": [
          {
            "source": "step",
            "ref": "deduplicated_csv"
          }
        ],
        "parameters": {
          "charts": [
            "length_distribution",
            "label_distribution"
          ],
          "width": 800,
          "height": 600
        },
        "outputs": [
          {
            "name": "chart_png",
            "format": "png"
          }
        ],
        "reason": "Generate basic statistical charts (length distribution and label distribution) from the cleaned dataset."
      }
    ]
  },

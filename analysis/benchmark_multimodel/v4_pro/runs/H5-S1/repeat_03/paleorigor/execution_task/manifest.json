            "format": "json"
          }
        ],
        "reason": "Confirm the uploaded ancient-sediment file is detected as FASTA before sequence processing."
      },
      {
        "id": "step_02",
        "skill": "seqkit_deduplicate",
        "inputs": [
          {
            "source": "uploaded",
            "ref": "sediment_amplicons.fna"
          }
        ],
        "parameters": {
          "by_sequence": true
        },
        "outputs": [
          {
            "name": "deduplicated_fasta",
            "format": "fasta"
          }
        ],
        "reason": "Remove duplicate nucleotide sequences from the ancient-sediment FASTA."
      },
      {

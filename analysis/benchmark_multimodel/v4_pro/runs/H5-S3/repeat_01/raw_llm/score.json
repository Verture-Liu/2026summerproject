{
  "strict_success": true,
  "decision": "workflow",
  "failure_codes": [],
  "workflow": {
    "schema_version": "1.0",
    "task_summary": "Curate peptide screening table by normalizing class and peptide columns, validating amino-acid sequences, deduplicating sequences, computing descriptive statistics, drawing a peptide length histogram, and exporting cleaned CSV plus rejected-row audit output.",
    "steps": [
      {
        "id": "step_01",
        "skill": "peptide_csv_normalize",
        "inputs": [
          {
            "source": "uploaded",
            "ref": "peptide_screen.csv"
          }
        ],
        "parameters": {
          "delimiter": "auto",
          "label_column": "class",
          "sequence_column": "peptide",
          "drop_empty_rows": true
        },
        "outputs": [
          {
            "name": "normalized_peptides.csv",
            "format": "csv"
          }
        ],
        "reason": "Normalize the raw peptide screening table into canonical label and sequence columns."
      },
      {
        "id": "step_02",
        "skill": "peptide_validate",
        "inputs": [
          {
            "source": "step",
            "ref": "normalized_peptides.csv"
          }
        ],
        "parameters": {
          "allowed_alphabet": "ACDEFGHIKLMNPQRSTVWY",
          "invalid_row_policy": "reject"
        },
        "outputs": [
          {
            "name": "validated_peptides.csv",
            "format": "csv"
          },
          {
            "name": "rejected_rows_audit.csv",
            "format": "csv"
          }
        ],
        "reason": "Validate amino-acid strings using the standard amino-acid alphabet and reject invalid rows, producing cleaned valid rows and an audit of rejected rows."
      },
      {
        "id": "step_03",
        "skill": "peptide_deduplicate",
        "inputs": [
          {
            "source": "step",
            "ref": "validated_peptides.csv"
          }
        ],
        "parameters": {
          "conflict_policy": "fail"
        },
        "outputs": [
          {
            "name": "deduplicated_peptides.csv",
            "format": "csv"
          }
        ],
        "reason": "Remove duplicate peptide sequences while failing on any conflicting class labels during curation."
      },
      {
        "id": "step_04",
        "skill": "peptide_statistics",
        "inputs": [
          {
            "source": "step",
            "ref": "deduplicated_peptides.csv"
          }
        ],
        "parameters": {
          "group_by_label": true,
          "include_amino_acid_composition": true
        },
        "outputs": [
          {
            "name": "peptide_statistics.csv",
            "format": "csv"
          }
        ],
        "reason": "Compute descriptive peptide counts, lengths, labels, and amino-acid composition for the curated dataset."
      },
      {
        "id": "step_05",
        "skill": "peptide_chart",
        "inputs": [
          {
            "source": "step",
            "ref": "deduplicated_peptides.csv"
          }
        ],
        "parameters": {
          "charts": [
            "length_histogram"
          ]
        },
        "outputs": [
          {
            "name": "peptide_length_histogram.png",
            "format": "png"
          }
        ],
        "reason": "Draw a single histogram of peptide lengths."
      },
      {
        "id": "step_06",
        "skill": "peptide_csv_export",
        "inputs": [
          {
            "source": "step",
            "ref": "deduplicated_peptides.csv"
          }
        ],
        "parameters": {
          "filename": "cleaned_peptides.csv"
        },
        "outputs": [
          {
            "name": "cleaned_peptides.csv",
            "format": "csv"
          }
        ],
        "reason": "Export the cleaned, validated, deduplicated peptide table to a safely named CSV."
      }
    ]
  },
  "validation": {
    "valid": true,
    "errors": [],
    "warnings": [],
    "issues": []
  }
}

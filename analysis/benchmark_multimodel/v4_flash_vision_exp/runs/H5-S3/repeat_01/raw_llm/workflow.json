{
  "schema_version": "1.0",
  "task_summary": "Curate peptide screening table: normalize class and peptide columns, validate amino-acid strings, deduplicate sequences, compute statistics, draw length histogram, and export cleaned CSV plus rejected-row audit.",
  "steps": [
    {
      "id": "step_01",
      "skill": "peptide_csv_normalize",
      "inputs": [
        {
          "source": "uploaded",
          "ref": "peptide_screen.csv"
        }
      ],
      "parameters": {
        "label_column": "class",
        "sequence_column": "peptide"
      },
      "outputs": [
        {
          "name": "normalized.csv",
          "format": "csv"
        }
      ],
      "reason": "Normalize the class and peptide columns into canonical label and sequence columns."
    },
    {
      "id": "step_02",
      "skill": "peptide_validate",
      "inputs": [
        {
          "source": "step",
          "ref": "normalized.csv"
        }
      ],
      "parameters": {
        "invalid_row_policy": "reject"
      },
      "outputs": [
        {
          "name": "validated.csv",
          "format": "csv"
        },
        {
          "name": "rejected_rows.csv",
          "format": "csv"
        }
      ],
      "reason": "Validate amino-acid sequences and binary labels, outputting valid rows and an audit of rejected rows."
    },
    {
      "id": "step_03",
      "skill": "peptide_deduplicate",
      "inputs": [
        {
          "source": "step",
          "ref": "validated.csv"
        }
      ],
      "parameters": {},
      "outputs": [
        {
          "name": "deduplicated.csv",
          "format": "csv"
        }
      ],
      "reason": "Remove duplicate peptide sequences and audit conflicting labels."
    },
    {
      "id": "step_04",
      "skill": "peptide_statistics",
      "inputs": [
        {
          "source": "step",
          "ref": "deduplicated.csv"
        }
      ],
      "parameters": {
        "group_by_label": true
      },
      "outputs": [
        {
          "name": "statistics.csv",
          "format": "csv"
        }
      ],
      "reason": "Compute descriptive statistics of peptide lengths, labels, and amino-acid composition."
    },
    {
      "id": "step_05",
      "skill": "peptide_chart",
      "inputs": [
        {
          "source": "step",
          "ref": "deduplicated.csv"
        }
      ],
      "parameters": {
        "charts": [
          "length_histogram"
        ]
      },
      "outputs": [
        {
          "name": "length_histogram.png",
          "format": "png"
        }
      ],
      "reason": "Draw a single histogram of peptide lengths."
    },
    {
      "id": "step_06",
      "skill": "peptide_csv_export",
      "inputs": [
        {
          "source": "step",
          "ref": "deduplicated.csv"
        }
      ],
      "parameters": {
        "filename": "cleaned.csv"
      },
      "outputs": [
        {
          "name": "cleaned.csv",
          "format": "csv"
        }
      ],
      "reason": "Export the cleaned CSV with selected columns."
    }
  ]
}

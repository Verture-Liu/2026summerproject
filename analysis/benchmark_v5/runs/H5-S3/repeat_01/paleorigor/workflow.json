{
  "schema_version": "1.0",
  "task_summary": "Curate the uploaded peptide screening CSV by normalizing class and peptide columns, validating amino-acid sequences, deduplicating peptides, computing descriptive statistics, creating a peptide-length histogram, and exporting the cleaned CSV with a rejected-row audit.",
  "steps": [
    {
      "id": "step_01",
      "skill": "peptide_csv_normalize",
      "inputs": [
        {
          "source": "uploaded",
          "ref": "peptide_screen.csv"
        }
      ],
      "parameters": {
        "delimiter": "auto",
        "label_column": "class",
        "sequence_column": "peptide",
        "drop_empty_rows": true
      },
      "outputs": [
        {
          "name": "normalized_peptides.csv",
          "format": "csv"
        }
      ],
      "reason": "Normalize the raw screening table to canonical label and sequence columns so downstream validation, deduplication, statistics, and export operate on a consistent peptide-table format."
    },
    {
      "id": "step_02",
      "skill": "peptide_validate",
      "inputs": [
        {
          "source": "step",
          "ref": "normalized_peptides.csv"
        }
      ],
      "parameters": {
        "invalid_row_policy": "reject"
      },
      "outputs": [
        {
          "name": "validated_peptides.csv",
          "format": "csv"
        },
        {
          "name": "rejected_row_audit.csv",
          "format": "csv"
        }
      ],
      "reason": "Validate binary labels and amino-acid sequences, rejecting invalid rows and emitting the rejected-row audit table requested by the user."
    },
    {
      "id": "step_03",
      "skill": "peptide_deduplicate",
      "inputs": [
        {
          "source": "step",
          "ref": "validated_peptides.csv"
        }
      ],
      "parameters": {
        "conflict_policy": "keep_first"
      },
      "outputs": [
        {
          "name": "deduplicated_peptides.csv",
          "format": "csv"
        }
      ],
      "reason": "Remove duplicate peptide sequences after validation to produce a non-redundant set for statistics, charting, and export."
    },
    {
      "id": "step_04",
      "skill": "data_quality_gate",
      "inputs": [
        {
          "source": "step",
          "ref": "deduplicated_peptides.csv"
        }
      ],
      "parameters": {
        "sequence_column": "sequence",
        "label_column": "label",
        "min_rows": 1
      },
      "outputs": [
        {
          "name": "quality_gate.json",
          "format": "json"
        }
      ],
      "reason": "Post-cleaning quality gate confirming the deduplicated table still has valid labeled peptide rows before descriptive output and downstream application."
    },
    {
      "id": "step_05",
      "skill": "peptide_statistics",
      "inputs": [
        {
          "source": "step",
          "ref": "deduplicated_peptides.csv"
        }
      ],
      "parameters": {
        "group_by_label": true
      },
      "outputs": [
        {
          "name": "peptide_statistics.json",
          "format": "json"
        },
        {
          "name": "peptide_statistics.csv",
          "format": "csv"
        }
      ],
      "reason": "Compute descriptive peptide statistics (counts, label breakdown, length summaries) from the validated, deduplicated peptide table."
    },
    {
      "id": "step_06",
      "skill": "peptide_chart",
      "inputs": [
        {
          "source": "step",
          "ref": "deduplicated_peptides.csv"
        }
      ],
      "parameters": {
        "charts": [
          "length_histogram"
        ]
      },
      "outputs": [
        {
          "name": "peptide_length_histogram.png",
          "format": "png"
        }
      ],
      "reason": "Create the requested single histogram of peptide lengths from the curated data."
    },
    {
      "id": "step_07",
      "skill": "peptide_csv_export",
      "inputs": [
        {
          "source": "step",
          "ref": "deduplicated_peptides.csv"
        }
      ],
      "parameters": {
        "filename": "cleaned_peptides.csv"
      },
      "outputs": [
        {
          "name": "cleaned_peptides.csv",
          "format": "csv"
        }
      ],
      "reason": "Export the final cleaned, non-redundant peptide table as the user-requested cleaned CSV artifact."
    }
  ]
}

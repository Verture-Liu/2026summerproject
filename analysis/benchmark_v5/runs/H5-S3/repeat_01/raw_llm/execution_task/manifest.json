  "workflow": {
    "schema_version": "1.0",
    "task_summary": "Curate the peptide screening table by normalizing class/peptide columns, validating amino-acid sequences, deduplicating peptides, computing descriptive statistics, generating a peptide-length histogram, and exporting the cleaned CSV and rejected-row audit.",
    "steps": [
      {
        "id": "step_01",
        "skill": "peptide_csv_normalize",
        "inputs": [
          {
            "source": "uploaded",
            "ref": "peptide_screen.csv"
          }
        ],
        "parameters": {
          "delimiter": "auto",
          "label_column": "class",
          "sequence_column": "peptide",
          "drop_empty_rows": true
        },
        "outputs": [
          {
            "name": "normalized_peptides",
            "format": "csv"
          }
        ],
        "reason": "Normalize the raw screening table's class and peptide columns into canonical label and sequence columns."
      },
      {
        "id": "step_02",
        "skill": "peptide_validate",
        "inputs": [
          {
            "source": "step",
            "ref": "step_01.normalized_peptides"
          }
        ],
        "parameters": {
          "allowed_alphabet": "ACDEFGHIKLMNPQRSTVWY",
          "invalid_row_policy": "reject"
        },
        "outputs": [
          {
            "name": "validated_peptides",
            "format": "csv"
          },
          {
            "name": "rejected_rows_audit",
            "format": "csv"
          }
        ],
        "reason": "Validate binary labels and amino-acid sequences, rejecting invalid rows and emitting an audit of rejected rows for traceability."
      },
      {
        "id": "step_03",
        "skill": "peptide_deduplicate",
        "inputs": [
          {
            "source": "step",
            "ref": "step_02.validated_peptides"
          }
        ],
        "parameters": {
          "conflict_policy": "keep_first",
          "keep": "first"
        },
        "outputs": [
          {
            "name": "deduplicated_peptides",
            "format": "csv"
          }
        ],
        "reason": "Remove duplicate peptide sequences while retaining the first occurrence to create a curated non-redundant set."
      },
      {
        "id": "step_04",
        "skill": "peptide_statistics",
        "inputs": [
          {
            "source": "step",
            "ref": "step_03.deduplicated_peptides"
          }
        ],
        "parameters": {
          "group_by_label": true
        },
        "outputs": [
          {
            "name": "peptide_statistics",
            "format": "json"
          }
        ],
        "reason": "Compute descriptive statistics for the curated peptides, including counts and length summaries grouped by label."
      },
      {
        "id": "step_05",
        "skill": "peptide_chart",
        "inputs": [
          {
            "source": "step",
            "ref": "step_03.deduplicated_peptides"
          }
        ],
        "parameters": {
          "charts": [
            "peptide_length_histogram"
          ]
        },
        "outputs": [
          {
            "name": "peptide_length_histogram",
            "format": "png"
          }
        ],
        "reason": "Generate a single histogram of peptide lengths for the deduplicated curated dataset."
      },
      {
        "id": "step_06",
        "skill": "peptide_csv_export",
        "inputs": [
          {
            "source": "step",
            "ref": "step_03.deduplicated_peptides"
          }
        ],
        "parameters": {
          "filename": "cleaned_peptides.csv"
        },
        "outputs": [
          {
            "name": "cleaned_peptides",
            "format": "csv"
          }
        ],
        "reason": "Export the cleaned, validated, and deduplicated peptide table as the final CSV deliverable."
      },
      {
        "id": "step_07",
        "skill": "peptide_csv_export",
        "inputs": [
          {
            "source": "step",
            "ref": "step_02.rejected_rows_audit"
          }
        ],
        "parameters": {
          "filename": "rejected_rows_audit.csv"
        },
        "outputs": [
          {
            "name": "rejected_rows_audit_export",
            "format": "csv"
          }
        ],
        "reason": "Export the rejected-row audit produced during validation so discarded entries can be inspected."
      }
    ]
  },

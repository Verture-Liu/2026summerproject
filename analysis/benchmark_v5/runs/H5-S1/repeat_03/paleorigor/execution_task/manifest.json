    "task_summary": "Inspect the ancient-sediment FASTA, remove duplicate sequences, retain records between 15 and 22 nucleotides, and report SeqKit statistics for the retained sequences while preserving intermediate FASTA outputs.",
    "steps": [
      {
        "id": "step_01",
        "skill": "file_type_detect",
        "inputs": [
          {
            "source": "uploaded",
            "ref": "sediment_amplicons.fna"
          }
        ],
        "parameters": {},
        "outputs": [
          {
            "name": "sediment_amplicons_filetype.json",
            "format": "json"
          }
        ],
        "reason": "Confirm that the uploaded sediment_amplicons.fna is FASTA before applying FASTA-oriented sequence operations."
      },
      {
        "id": "step_02",
        "skill": "seqkit_deduplicate",
        "inputs": [
          {
            "source": "uploaded",
            "ref": "sediment_amplicons.fna"
          }
        ],
        "parameters": {
          "by_sequence": true
        },
        "outputs": [
          {
            "name": "sediment_amplicons_deduplicated.fasta",
            "format": "fasta"
          }
        ],
        "reason": "Remove duplicate FASTA sequences so that only unique sediment amplicon records proceed to length filtering."
      },
      {
        "id": "step_03",
        "skill": "seqkit_length_filter",
        "inputs": [
          {
            "source": "step",
            "ref": "sediment_amplicons_deduplicated.fasta"
          }
        ],
        "parameters": {
          "min_length": 15,
          "max_length": 22
        },
        "outputs": [
          {
            "name": "sediment_amplicons_15_22.fasta",
            "format": "fasta"
          }
        ],
        "reason": "Retain only deduplicated FASTA records whose nucleotide length is between 15 and 22 bases as requested."
      },
      {
        "id": "step_04",
        "skill": "data_quality_gate",
        "inputs": [
          {
            "source": "step",
            "ref": "sediment_amplicons_15_22.fasta"
          }
        ],
        "parameters": {},
        "outputs": [
          {
            "name": "sediment_amplicons_quality_gate.json",
            "format": "json"
          }
        ],
        "reason": "Run a cleaned-data quality gate on the filtered FASTA before generating the final SeqKit statistics summary."
      },
      {
        "id": "step_05",
        "skill": "seqkit_stats",
        "inputs": [
          {
            "source": "step",
            "ref": "sediment_amplicons_15_22.fasta"
          }
        ],
        "parameters": {},
        "outputs": [
          {
            "name": "retained_seqkit_stats.json",
            "format": "json"
          }
        ],
        "reason": "Produce machine-readable SeqKit statistics for the retained 15-22 nucleotide sequences."
      }
    ]
  },

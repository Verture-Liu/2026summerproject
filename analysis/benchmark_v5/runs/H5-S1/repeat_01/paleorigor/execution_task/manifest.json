            "format": "json"
          }
        ],
        "reason": "Confirm the uploaded file is FASTA before sequence processing."
      },
      {
        "id": "step_02",
        "skill": "seqkit_deduplicate",
        "inputs": [
          {
            "source": "uploaded",
            "ref": "sediment_amplicons.fna"
          }
        ],
        "parameters": {},
        "outputs": [
          {
            "name": "deduplicated_amplicons",
            "format": "fasta"
          }
        ],
        "reason": "Remove duplicate sequences from the FASTA and keep the non-redundant intermediate file."

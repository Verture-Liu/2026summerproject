{
  "schema_version": "1.0",
  "task_summary": "Validate paired-end relationship between crypt_library_1.fq and crypt_library_2.fq, run FastQC independently on each FASTQ file, and aggregate the FastQC ZIP results into a single MultiQC report while retaining all QC evidence.",
  "steps": [
    {
      "id": "step_01",
      "skill": "fastq_pair_match",
      "inputs": [
        {
          "source": "uploaded",
          "ref": "crypt_library_1.fq"
        },
        {
          "source": "uploaded",
          "ref": "crypt_library_2.fq"
        }
      ],
      "parameters": {},
      "outputs": [
        {
          "name": "crypt_library_paired_mates.json",
          "format": "json"
        }
      ],
      "reason": "Check whether the two crypt-library FASTQ files are paired-end mates before proceeding with QC."
    },
    {
      "id": "step_02",
      "skill": "fastq_qc",
      "inputs": [
        {
          "source": "uploaded",
          "ref": "crypt_library_1.fq"
        }
      ],
      "parameters": {},
      "outputs": [
        {
          "name": "crypt_library_1_fastqc.zip",
          "format": "zip"
        },
        {
          "name": "crypt_library_1_fastqc.html",
          "format": "html"
        }
      ],
      "reason": "Generate an independent FastQC report and ZIP archive for the first read mate."
    },
    {
      "id": "step_03",
      "skill": "fastq_qc",
      "inputs": [
        {
          "source": "uploaded",
          "ref": "crypt_library_2.fq"
        }
      ],
      "parameters": {},
      "outputs": [
        {
          "name": "crypt_library_2_fastqc.zip",
          "format": "zip"
        },
        {
          "name": "crypt_library_2_fastqc.html",
          "format": "html"
        }
      ],
      "reason": "Generate an independent FastQC report and ZIP archive for the second read mate."
    },
    {
      "id": "step_04",
      "skill": "multiqc_summary",
      "inputs": [
        {
          "source": "step",
          "ref": "crypt_library_1_fastqc.zip"
        },
        {
          "source": "step",
          "ref": "crypt_library_2_fastqc.zip"
        }
      ],
      "parameters": {},
      "outputs": [
        {
          "name": "multiqc_report.html",
          "format": "html"
        },
        {
          "name": "multiqc_data.json",
          "format": "json"
        }
      ],
      "reason": "Aggregate both FastQC ZIP archives into one MultiQC report, preserving all QC evidence."
    }
  ]
}

    "schema_version": "1.0",
    "task_summary": "Detect file type, deduplicate archaeological FASTA with SeqKit, filter to 14-22 base fragments, pass a quality gate, and compute SeqKit statistics while preserving deduplicated, filtered, and audit outputs.",
    "steps": [
      {
        "id": "step_01",
        "skill": "file_type_detect",
        "inputs": [
          {
            "source": "uploaded",
            "ref": "ancient_fragments.fasta"
          }
        ],
        "parameters": {},
        "outputs": [
          {
            "name": "file_type_report",
            "format": "json"
          }
        ],
        "reason": "Confirm the uploaded file is FASTA-formatted before running sequence utilities."
      },
      {
        "id": "step_02",
        "skill": "seqkit_deduplicate",
        "inputs": [
          {
            "source": "uploaded",
            "ref": "ancient_fragments.fasta"
          }
        ],
        "parameters": {
          "by_sequence": true
        },
        "outputs": [
          {
            "name": "deduplicated_sequences",
            "format": "fasta"
          },
          {
            "name": "deduplication_report",
            "format": "json"
          }
        ],
        "reason": "Remove duplicate sequences with SeqKit and retain the deduplicated FASTA plus its audit report."
      },
      {
        "id": "step_03",
        "skill": "seqkit_length_filter",
        "inputs": [
          {
            "source": "step",
            "ref": "deduplicated_sequences"
          }
        ],
        "parameters": {
          "min_length": 14,
          "max_length": 22
        },
        "outputs": [
          {
            "name": "filtered_sequences",
            "format": "fasta"
          },
          {
            "name": "length_filter_report",
            "format": "json"
          }
        ],
        "reason": "Retain only sequences between 14 and 22 bases as requested, preserving the filtered FASTA and audit output."
      },
      {
        "id": "step_04",
        "skill": "data_quality_gate",
        "inputs": [
          {
            "source": "step",
            "ref": "filtered_sequences"
          }
        ],
        "parameters": {
          "min_records": 1
        },
        "outputs": [
          {
            "name": "quality_gate_report",
            "format": "json"
          }
        ],
        "reason": "Run a cleaned-data quality gate on the deduplicated and filtered FASTA before final statistics."
      },
      {
        "id": "step_05",
        "skill": "seqkit_stats",
        "inputs": [
          {
            "source": "step",
            "ref": "filtered_sequences"
          }
        ],
        "parameters": {},
        "outputs": [
          {
            "name": "final_sequence_statistics",
            "format": "tsv"
          },
          {
            "name": "final_sequence_statistics_json",
            "format": "json"
          }
        ],
        "reason": "Calculate SeqKit summary statistics for the final 14-22 base FASTA."
      }
    ]
  },

        "outputs": [
          {
            "name": "final_sequence_statistics",
            "format": "tsv"
          },
          {
            "name": "final_sequence_statistics_json",
            "format": "json"
          }
        ],
        "reason": "Calculate SeqKit summary statistics for the final 14-22 base FASTA."

          }
        ],
        "reason": "Retain only sequences between 14 and 22 bases after deduplication, preserving the filtered FASTA and audit JSON."
      },
      {
        "id": "step_04",
        "skill": "data_quality_gate",
        "inputs": [
          {
            "source": "step",

          }
        ],
        "parameters": {
          "by_sequence": true
        },
        "outputs": [
          {
            "name": "ancient_fragments_dedup.fasta",
            "format": "fasta"
          },
          {
            "name": "ancient_fragments_dedup_audit.json",
            "format": "json"
          }
        ],
        "reason": "Remove duplicate sequences with SeqKit while preserving the deduplicated FASTA and an audit record."
      },
      {
        "id": "step_03",
        "skill": "seqkit_length_filter",
        "inputs": [
          {
            "source": "step",

{
  "schema_version": "1.0",
  "task_summary": "Normalize, validate, deduplicate, summarize, chart, and export a labelled peptide CSV while preserving an audit copy before rejection.",
  "steps": [
    {
      "id": "step_01",
      "skill": "peptide_csv_normalize",
      "inputs": [
        {
          "source": "uploaded",
          "ref": "curated_candidates.csv"
        }
      ],
      "parameters": {},
      "outputs": [
        {
          "name": "normalized_candidates.csv",
          "format": "csv"
        }
      ],
      "reason": "Normalize the uploaded labelled peptide CSV into canonical label and sequence columns."
    },
    {
      "id": "step_02",
      "skill": "peptide_csv_export",
      "inputs": [
        {
          "source": "step",
          "ref": "normalized_candidates.csv"
        }
      ],
      "parameters": {},
      "outputs": [
        {
          "name": "normalized_audit.csv",
          "format": "csv"
        }
      ],
      "reason": "Export the normalized table as an audit copy before validation so any rejected rows are preserved for later review."
    },
    {
      "id": "step_03",
      "skill": "peptide_validate",
      "inputs": [
        {
          "source": "step",
          "ref": "normalized_candidates.csv"
        }
      ],
      "parameters": {
        "invalid_row_policy": "reject"
      },
      "outputs": [
        {
          "name": "validated_candidates.csv",
          "format": "csv"
        }
      ],
      "reason": "Validate binary labels and canonical amino-acid sequences, rejecting invalid rows without failing while keeping the pre-validation audit copy."
    },
    {
      "id": "step_04",
      "skill": "peptide_deduplicate",
      "inputs": [
        {
          "source": "step",
          "ref": "validated_candidates.csv"
        }
      ],
      "parameters": {
        "conflict_policy": "prefer_positive"
      },
      "outputs": [
        {
          "name": "deduplicated_candidates.csv",
          "format": "csv"
        }
      ],
      "reason": "Remove duplicate peptide sequences, preferring the positive label when duplicate labels conflict."
    },
    {
      "id": "step_05",
      "skill": "peptide_statistics",
      "inputs": [
        {
          "source": "step",
          "ref": "deduplicated_candidates.csv"
        }
      ],
      "parameters": {},
      "outputs": [
        {
          "name": "peptide_statistics.json",
          "format": "json"
        }
      ],
      "reason": "Calculate summary statistics for the cleaned, deduplicated peptide dataset."
    },
    {
      "id": "step_06",
      "skill": "peptide_chart",
      "inputs": [
        {
          "source": "step",
          "ref": "deduplicated_candidates.csv"
        }
      ],
      "parameters": {
        "charts": [
          "length"
        ]
      },
      "outputs": [
        {
          "name": "peptide_length_histogram.png",
          "format": "png"
        }
      ],
      "reason": "Create a single peptide-length histogram from the cleaned dataset."
    },
    {
      "id": "step_07",
      "skill": "peptide_csv_export",
      "inputs": [
        {
          "source": "step",
          "ref": "deduplicated_candidates.csv"
        }
      ],
      "parameters": {},
      "outputs": [
        {
          "name": "cleaned_candidates.csv",
          "format": "csv"
        }
      ],
      "reason": "Export the final cleaned and deduplicated peptide table as the requested cleaned CSV."
    }
  ]
}

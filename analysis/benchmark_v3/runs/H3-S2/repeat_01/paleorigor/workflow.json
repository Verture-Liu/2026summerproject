{
  "schema_version": "1.0",
  "task_summary": "Validate two FASTQ files as a paired-end sample, run separate FastQC per mate, aggregate both FastQC ZIP reports with MultiQC, and preserve the pair report and QC outputs.",
  "steps": [
    {
      "id": "step_01",
      "skill": "file_type_detect",
      "inputs": [
        {
          "source": "uploaded",
          "ref": "heldout_pair_R1.fastq"
        },
        {
          "source": "uploaded",
          "ref": "heldout_pair_R2.fastq"
        }
      ],
      "parameters": {},
      "outputs": [
        {
          "name": "file_type_report",
          "format": "json"
        }
      ],
      "reason": "Confirm that both uploaded files are FASTQ before pairing and QC."
    },
    {
      "id": "step_02",
      "skill": "fastq_pair_match",
      "inputs": [
        {
          "source": "uploaded",
          "ref": "heldout_pair_R1.fastq"
        },
        {
          "source": "uploaded",
          "ref": "heldout_pair_R2.fastq"
        }
      ],
      "parameters": {},
      "outputs": [
        {
          "name": "sample_pair_report",
          "format": "csv"
        },
        {
          "name": "sample_pair_report_json",
          "format": "json"
        }
      ],
      "reason": "Match the two mates into a paired-end sample row and preserve the pair report."
    },
    {
      "id": "step_03",
      "skill": "fastq_qc",
      "inputs": [
        {
          "source": "uploaded",
          "ref": "heldout_pair_R1.fastq"
        }
      ],
      "parameters": {},
      "outputs": [
        {
          "name": "heldout_pair_R1_fastqc.zip",
          "format": "zip"
        },
        {
          "name": "heldout_pair_R1_fastqc.html",
          "format": "html"
        }
      ],
      "reason": "Run FastQC on the first mate to assess raw read quality before aggregation."
    },
    {
      "id": "step_04",
      "skill": "fastq_qc",
      "inputs": [
        {
          "source": "uploaded",
          "ref": "heldout_pair_R2.fastq"
        }
      ],
      "parameters": {},
      "outputs": [
        {
          "name": "heldout_pair_R2_fastqc.zip",
          "format": "zip"
        },
        {
          "name": "heldout_pair_R2_fastqc.html",
          "format": "html"
        }
      ],
      "reason": "Run FastQC on the second mate to assess raw read quality before aggregation."
    },
    {
      "id": "step_05",
      "skill": "multiqc_summary",
      "inputs": [
        {
          "source": "step",
          "ref": "heldout_pair_R1_fastqc.zip"
        },
        {
          "source": "step",
          "ref": "heldout_pair_R2_fastqc.zip"
        }
      ],
      "parameters": {},
      "outputs": [
        {
          "name": "multiqc_report.html",
          "format": "html"
        },
        {
          "name": "multiqc_report.json",
          "format": "json"
        }
      ],
      "reason": "Aggregate both per-mate FastQC ZIP reports into a single MultiQC summary."
    }
  ]
}

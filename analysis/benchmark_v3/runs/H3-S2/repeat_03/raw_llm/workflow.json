{
  "schema_version": "1.0",
  "task_summary": "Validate R1/R2 FASTQ files as a paired-end sample, run FastQC per mate, and aggregate the resulting ZIP reports with MultiQC.",
  "steps": [
    {
      "id": "step_01",
      "skill": "fastq_pair_match",
      "inputs": [
        {
          "source": "uploaded",
          "ref": "heldout_pair_R1.fastq"
        },
        {
          "source": "uploaded",
          "ref": "heldout_pair_R2.fastq"
        }
      ],
      "parameters": {},
      "outputs": [
        {
          "name": "pair_report.json",
          "format": "json"
        }
      ],
      "reason": "Match the R1 and R2 FASTQ files to validate them as a paired-end sample and preserve the pair report."
    },
    {
      "id": "step_02",
      "skill": "fastq_qc",
      "inputs": [
        {
          "source": "uploaded",
          "ref": "heldout_pair_R1.fastq"
        }
      ],
      "parameters": {},
      "outputs": [
        {
          "name": "R1_fastqc.zip",
          "format": "zip"
        },
        {
          "name": "R1_fastqc.html",
          "format": "html"
        }
      ],
      "reason": "Run FastQC separately on mate R1 and preserve its ZIP report for MultiQC aggregation plus the HTML QC output."
    },
    {
      "id": "step_03",
      "skill": "fastq_qc",
      "inputs": [
        {
          "source": "uploaded",
          "ref": "heldout_pair_R2.fastq"
        }
      ],
      "parameters": {},
      "outputs": [
        {
          "name": "R2_fastqc.zip",
          "format": "zip"
        },
        {
          "name": "R2_fastqc.html",
          "format": "html"
        }
      ],
      "reason": "Run FastQC separately on mate R2 and preserve its ZIP report for MultiQC aggregation plus the HTML QC output."
    },
    {
      "id": "step_04",
      "skill": "multiqc_summary",
      "inputs": [
        {
          "source": "step",
          "ref": "R1_fastqc.zip"
        },
        {
          "source": "step",
          "ref": "R2_fastqc.zip"
        }
      ],
      "parameters": {},
      "outputs": [
        {
          "name": "multiqc_report.html",
          "format": "html"
        }
      ],
      "reason": "Aggregate both FastQC ZIP reports into a single MultiQC report while preserving the individual QC outputs."
    }
  ]
}

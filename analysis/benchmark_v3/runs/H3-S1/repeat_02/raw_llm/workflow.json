{
  "schema_version": "1.0",
  "task_summary": "Detect the file type of the uploaded single-end FASTQ, run FastQC quality control, compute SeqKit statistics, and retain auditable JSON/HTML/ZIP/TSV outputs.",
  "steps": [
    {
      "id": "step_01",
      "skill": "file_type_detect",
      "inputs": [
        {
          "source": "uploaded",
          "ref": "heldout_single.fastq"
        }
      ],
      "parameters": {},
      "outputs": [
        {
          "name": "detected_file_type.json",
          "format": "json"
        }
      ],
      "reason": "Confirm the uploaded file type before running downstream FASTQ processing."
    },
    {
      "id": "step_02",
      "skill": "fastq_qc",
      "inputs": [
        {
          "source": "uploaded",
          "ref": "heldout_single.fastq"
        }
      ],
      "parameters": {
        "threads": 2
      },
      "outputs": [
        {
          "name": "fastqc_report.html",
          "format": "html"
        },
        {
          "name": "fastqc_summary.json",
          "format": "json"
        },
        {
          "name": "fastqc_raw.zip",
          "format": "zip"
        }
      ],
      "reason": "Run FastQC on the single-end FASTQ file to produce auditable quality-control outputs."
    },
    {
      "id": "step_03",
      "skill": "seqkit_stats",
      "inputs": [
        {
          "source": "uploaded",
          "ref": "heldout_single.fastq"
        }
      ],
      "parameters": {},
      "outputs": [
        {
          "name": "seqkit_stats.json",
          "format": "json"
        },
        {
          "name": "seqkit_stats.tsv",
          "format": "tsv"
        }
      ],
      "reason": "Compute sequence counts, total bases, and length statistics with SeqKit for auditable reporting."
    }
  ]
}

        "parameters": {
          "group_by_label": true,
          "include_amino_acid_composition": true
        },
        "outputs": [
          {
            "name": "peptide_statistics.csv",
            "format": "csv"
          },
          {
            "name": "peptide_statistics.json",
            "format": "json"
          }
        ],
        "reason": "Calculate descriptive peptide statistics including counts, lengths, label distributions, and amino-acid composition for the cleaned cleaned dataset."

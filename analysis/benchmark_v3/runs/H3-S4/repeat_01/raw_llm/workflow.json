{
  "schema_version": "1.0",
  "task_summary": "Run raw FastQC on the uploaded FASTQ, filter reads to 12-18 bases with SeqKit, run a post-filter quality gate on the filtered FASTQ, and generate post-filter SeqKit statistics while retaining the filtered FASTQ and audit reports.",
  "steps": [
    {
      "id": "step_01",
      "skill": "fastq_qc",
      "inputs": [
        {
          "source": "uploaded",
          "ref": "heldout_variable_length.fastq"
        }
      ],
      "parameters": {},
      "outputs": [
        {
          "name": "fastqc_report.html",
          "format": "html"
        },
        {
          "name": "fastqc_data.json",
          "format": "json"
        }
      ],
      "reason": "Run raw FastQC on the uploaded FASTQ to generate the requested raw QC audit report."
    },
    {
      "id": "step_02",
      "skill": "seqkit_length_filter",
      "inputs": [
        {
          "source": "uploaded",
          "ref": "heldout_variable_length.fastq"
        }
      ],
      "parameters": {
        "min_length": 12,
        "max_length": 18
      },
      "outputs": [
        {
          "name": "filtered.fastq",
          "format": "fastq"
        },
        {
          "name": "length_filter_report.json",
          "format": "json"
        }
      ],
      "reason": "Retain reads between 12 and 18 bases with SeqKit, preserving the filtered FASTQ and a length-filter audit report."
    },
    {
      "id": "step_03",
      "skill": "data_quality_gate",
      "inputs": [
        {
          "source": "step",
          "ref": "filtered.fastq"
        }
      ],
      "parameters": {
        "min_records": 1,
        "fail_on_error": true
      },
      "outputs": [
        {
          "name": "quality_gate_report.json",
          "format": "json"
        }
      ],
      "reason": "Apply a post-filter quality gate to the filtered FASTQ so the retained read set is confirmed to contain at least one record and the audit report is stored."
    },
    {
      "id": "step_04",
      "skill": "seqkit_stats",
      "inputs": [
        {
          "source": "step",
          "ref": "filtered.fastq"
        }
      ],
      "parameters": {},
      "outputs": [
        {
          "name": "post_filter_seqkit_stats.tsv",
          "format": "tsv"
        }
      ],
      "reason": "Calculate post-filter SeqKit statistics on the retained FASTQ to produce the requested final audit report."
    }
  ]
}
